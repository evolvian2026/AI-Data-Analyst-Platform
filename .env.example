# ---------------------------------------------------------------------------
# Copy to .env and fill in before running docker compose up.
# ---------------------------------------------------------------------------

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required by the database container.
POSTGRES_PASSWORD=
POSTGRES_USER=analyst
POSTGRES_DB=ai_data_analyst

ENVIRONMENT=production
WEB_PORT=8080

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8080

# Upload and retention limits.
MAX_UPLOAD_MB=100

# Two separate retention windows, because the two artefacts carry different risk.
#
# FILE_RETENTION_HOURS removes the uploaded workbook - the raw rows, the most
# sensitive thing stored. The analysis survives, so reports stay readable.
FILE_RETENTION_HOURS=72
#
# RESULT_RETENTION_DAYS removes the analysis itself, which still holds
# aggregates, column names and sample values drawn from the upload. 0 keeps
# analyses indefinitely; set it to whatever your data-handling policy requires.
RESULT_RETENTION_DAYS=0

ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------------
# AI provider.
#
# "deterministic" (the default) uses no external model at all: narration is
# composed from the values the analytics engine calculated, so nothing can be
# fabricated and no data leaves the server.
#
# Set "anthropic" or "openai" to have a model rephrase that narration. Every
# figure in a generated sentence is checked against the calculated results, and
# any response containing an unverifiable number is discarded in favour of the
# engine's own wording.
# ---------------------------------------------------------------------------
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_BASE_URL=https://api.anthropic.com

# Leave false: only aggregates, profiles and statistics are shared with the
# model, never the uploaded rows.
AI_ALLOW_RAW_ROWS=false
